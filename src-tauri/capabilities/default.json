{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for linXiv",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-lstat",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "opener:default",
    "texbrain:default",
    "updater:default",
    "process:default"
  ]
}
