{
  "name": "linxiv-gui-react",
  "private": true,
  "version": "0.4.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "submodules": "git submodule update --init --recursive || true",
    "dev": "vite",
    "predev:api": "npm run submodules",
    "dev:api": "cd src-tauri && cargo run -p linxiv-server --bin linxiv-dev-server",
    "build": "tsc && vite build",
    "pretest": "node -e \"if(!require('node:fs').globSync('src/**/*.test.ts').length)throw Error('no test files matched src/**/*.test.ts')\"",
    "test": "node --experimental-transform-types --test \"src/**/*.test.ts\"",
    "types:gen": "cd src-tauri && UPDATE_BINDINGS=1 cargo test -p linxiv-core ts_bindings",
    "types:check": "cd src-tauri && cargo test -p linxiv-core ts_bindings",
    "preview": "vite preview",
    "pretauri": "npm run submodules",
    "tauri": "tauri",
    "build:sidecar": "bash scripts/fetch_pdfium.sh && bash scripts/stage_rust_bins.sh",
    "build:all": "npm run build:sidecar && npm run tauri build",
    "build:arch": "bash scripts/build_arch_package.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.2",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.35.0",
    "mathjax-full": "^3.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
